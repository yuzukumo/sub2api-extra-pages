{
  "name": "sub2api-document-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server-dist/index.js",
    "test": "vitest run",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/x-markdown": "^2.8.0",
    "@fastify/static": "^10.1.2",
    "@tanstack/react-query": "^5.90.0",
    "antd": "^6.5.1",
    "dompurify": "^3.2.6",
    "dotenv": "^17.4.2",
    "fastify": "^5.0.0",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.12",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-highlight": "^2.2.4",
    "mermaid": "^11.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
